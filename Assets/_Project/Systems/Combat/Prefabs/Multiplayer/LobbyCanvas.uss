/* ── Root overlay ── */
.lobby-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.72);
}

/* ── Panel base ── */
.panel {
    background-color: rgba(14, 12, 22, 0.97);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(160, 120, 60, 0.45);
    padding: 28px 36px 36px 36px;
    min-width: 380px;
    max-width: 420px;
    align-items: stretch;
}
.panel-centered {
    align-items: center;
    justify-content: center;
    padding: 40px 48px;
}

/* ── Panel header ── */
.panel-header {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 4px;
}
.header-titles { flex-direction: column; flex-grow: 1; }
.header-title  { margin-bottom: 0; }

/* ── Close button ── */
.close-btn {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    color: rgb(160, 140, 100);
    font-size: 14px;
    -unity-font-style: bold;
    padding: 0;
    margin-left: 8px;
    margin-top: 2px;
    flex-shrink: 0;
}
.close-btn:hover  { background-color: rgba(255,255,255,0.16); color: white; }
.close-btn:active { background-color: rgba(255,255,255,0.06); }

/* ── Typography ── */
.brand {
    font-size: 26px;
    color: rgb(230, 195, 100);
    -unity-font-style: bold;
    -unity-text-align: upper-left;
    letter-spacing: 4px;
    margin-bottom: 2px;
}
.subtitle {
    font-size: 12px;
    color: rgb(130, 110, 70);
    -unity-text-align: upper-left;
    letter-spacing: 2px;
    margin-bottom: 16px;
}
.separator-label {
    font-size: 11px;
    color: rgb(80, 72, 55);
    -unity-text-align: upper-center;
    margin-top: 4px;
    margin-bottom: 4px;
}
.transition-text {
    font-size: 16px;
    color: rgb(180, 160, 100);
    -unity-text-align: upper-center;
    margin-top: 16px;
    margin-bottom: 4px;
    min-width: 160px;
}
.wait-status {
    font-size: 12px;
    color: rgb(130, 150, 130);
    -unity-text-align: upper-center;
    margin-top: 12px;
    margin-bottom: 18px;
}
.error-label {
    font-size: 12px;
    color: rgb(220, 80, 80);
    -unity-text-align: upper-center;
    margin-top: 8px;
    white-space: normal;
}

/* ── Room code ── */
.room-code {
    font-size: 13px;
    color: rgb(100, 200, 120);
    -unity-text-align: upper-center;
    background-color: rgba(60, 130, 70, 0.15);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(80, 160, 90, 0.3);
    padding: 8px 14px;
    margin-bottom: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* ── Divider ── */
.divider {
    height: 1px;
    background-color: rgba(160, 120, 60, 0.22);
    margin-bottom: 20px;
}

/* ── Input ── */
.input-field {
    margin-bottom: 10px;
    margin-top: 6px;
    height: 38px;
    font-size: 14px;
    color: rgb(220, 220, 220);
    background-color: rgba(255, 255, 255, 0.06);
    border-color: rgba(160, 120, 60, 0.35);
    border-radius: 8px;
    padding: 0 12px;
}
.input-field:focus { border-color: rgba(220, 180, 80, 0.6); }

/* ── Buttons ── */
.btn {
    height: 44px;
    border-radius: 8px;
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    border-width: 0;
}
.btn:hover    { opacity: 0.82; }
.btn:active   { opacity: 0.65; }
.btn:disabled { opacity: 0.32; }

.btn-primary   { background-color: rgb(90, 130, 210);  color: white; }
.btn-secondary { background-color: rgb(55, 80, 130);   color: rgb(190, 210, 255); }
.btn-combat    { background-color: rgb(170, 55, 55);   color: white; }
.btn-neutral   { background-color: rgb(50, 50, 60);    color: rgb(160, 160, 160); }

/* ── Cancel btn (transition panel) ── */
.cancel-btn {
    margin-top: 20px;
    min-width: 140px;
    align-self: center;
    height: 38px;
    font-size: 13px;
}

/* ── Player slots ── */
.slots-container { flex-direction: column; margin-bottom: 4px; }
.player-slot {
    flex-direction: row;
    align-items: center;
    padding: 12px 16px;
    border-radius: 10px;
    margin-bottom: 8px;
    border-width: 1px;
}
.slot-ready   { background-color: rgba(50,120,60,0.22);  border-color: rgba(70,170,85,0.35); }
.slot-waiting { background-color: rgba(90,70,25,0.18);   border-color: rgba(150,110,35,0.28); }
.slot-icon  { font-size: 16px; color: rgb(200,170,80); margin-right: 12px; width: 22px; -unity-text-align: upper-center; flex-shrink: 0; }
.slot-name  { font-size: 13px; color: rgb(205,205,205); flex-grow: 1; }

/* ── Spinner ── */
.spinner-ring {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    border-width: 3px;
    border-color: rgba(220,180,80,0.7);
    border-bottom-color: rgba(220,180,80,0.1);
    margin-bottom: 8px;
}

/* ── Utility ── */
.hidden { display: none; }
